# Скопировать в .env и заполнить. .env в git не коммитим.

# --- Postgres ---
POSTGRES_DB=ai_interviews
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

CORE_DB_USER=core
CORE_DB_PASSWORD=core

AI_DB_USER=ai
AI_DB_PASSWORD=ai

# --- Auth ---
JWT_ACCESS_TTL=15m
# Общий секрет для вызовов ai-service -> core-api /internal/*
INTERNAL_API_TOKEN=change-me

# --- LLM ---
LLM_PROVIDER=routerai
ROUTERAI_API_KEY=
ROUTERAI_MODEL=
