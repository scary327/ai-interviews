{
    "tabWidth": 4,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "none",
    "jsxSingleQuote": false,
    "printWidth": 100,
    "useTabs": false,
    "endOfLine": "auto",
    "arrowParens": "always",
    "plugins": ["prettier-plugin-tailwindcss"],
    "tailwindStylesheet": "./src/app/styles/globals.css",
    "tailwindFunctions": ["cn", "cva"]
}
